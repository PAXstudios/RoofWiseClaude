# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`. Production keys go in EAS Secrets.

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
# ----------------------------------------------------------------------------
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-pro

# ----------------------------------------------------------------------------
# Google Maps Platform — start with ONE key, split into iOS/Android/Web
# restricted keys before production.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# Service keys (default to the base Maps key when omitted)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_SOLAR_API_KEY=
EXPO_PUBLIC_GOOGLE_GEOCODING_API_KEY=
EXPO_PUBLIC_GOOGLE_WEATHER_API_KEY=

# ----------------------------------------------------------------------------
# App config
# ----------------------------------------------------------------------------
EXPO_PUBLIC_APP_URL_SCHEME=roofwise
EXPO_PUBLIC_CORRECTIONS_ENDPOINT=https://roofwise-backend.vercel.app/api/v1/corrections/batch
EXPO_PUBLIC_NOAA_USER_AGENT=RoofWise iOS / contact@roofwise.app

# Feature flags
EXPO_PUBLIC_USE_LIVE_AR=false
EXPO_PUBLIC_USE_STRUCTURED_CONFIDENCE=true
EXPO_PUBLIC_REQUIRE_AUTH=false
