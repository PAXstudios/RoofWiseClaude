# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`. Production keys go in EAS Secrets.

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
# ----------------------------------------------------------------------------
EXPO_PUBLIC_GEMINI_API_KEY=
# Newest Flash model (owner directive 2026-09-01). This is only the FIRST model
# tried: lib/services/gemini.ts falls through
#   <this value> → gemini-3.8-flash → gemini-3.7-flash → gemini-3.5-flash → gemini-2.5-flash
# whenever Google answers HTTP 404 / "no longer available" for a model id, and
# records the model that actually answered on each analysis (modelUsed).
# Other errors (quota, safety, key) are NOT retried across models.
# gemini-2.5-pro is RETIRED for new keys — it returns 404; do not set it here.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash

# ----------------------------------------------------------------------------
# Google Maps Platform — start with ONE key, split into iOS/Android/Web
# restricted keys before production.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# Service keys (default to the base Maps key when omitted)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_SOLAR_API_KEY=
EXPO_PUBLIC_GOOGLE_GEOCODING_API_KEY=
EXPO_PUBLIC_GOOGLE_WEATHER_API_KEY=

# ----------------------------------------------------------------------------
# App config
# ----------------------------------------------------------------------------
EXPO_PUBLIC_APP_URL_SCHEME=roofwise
# Corrections sync to Supabase `public.corrections` (supabase/schema.sql) with
# the keys above — there is no separate corrections endpoint any more.
# Optional — lib/env.ts falls back to this exact value when unset. IEM asks
# automated clients to identify themselves with a contact address.
EXPO_PUBLIC_NOAA_USER_AGENT=RoofWise/1.0 (iOS; contact@roofwise.app)

# Feature flags
EXPO_PUBLIC_USE_LIVE_AR=false
EXPO_PUBLIC_USE_STRUCTURED_CONFIDENCE=true
EXPO_PUBLIC_REQUIRE_AUTH=false
